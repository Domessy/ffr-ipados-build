+static int checks, failed;
+#define CHECK(c, why) do { checks++; if (!(c)) { failed++; fprintf(stderr,"FAIL: %s\n",why); } } while (0)
+@interface RefreshView : NSObject
+@property(nonatomic,strong) id parentTexture;
+@end
+@implementation RefreshView @end
+static void ownership(void) {
+    NSObject *base = [NSObject new];
+    for (uint64_t k=1;k<=900;k++) tex_put(k,base);
+    CHECK(g_ghost.n==900 && g_ghost_use.n==900,"more than 512 currently used textures survive");
+    for (uint64_t k=1;k<=900;k++) CHECK(tex_get(k)==base,"every finalized ID still resolves");
+    CHECK(g_ghost_lru->serial==1 && g_ghost_mru->serial==900,"reads update use order");
+    uint64_t held=17; RefreshView *view=[RefreshView new]; view.parentTexture=base;
+    vc_key key={.pf=MTLPixelFormatRGBA8Unorm,.nl=1,.ns=1};
+    os_unfair_lock_lock(&g_rmu);
+    vc_put(held,NULL,&key,(id)view); uint64_t made=g_vc_new;
+    CHECK(vc_get(held,&key,(id)base)==(id)view,"finalized texture's view is reused");
+    CHECK(vc_get(held,&key,(id)base)==(id)view && g_vc_new==made,"repeated reads make no view");
+    CHECK(vc_set_for(held,NULL,0)==NULL,"finalized 2D rows use their own memory owner");
+    os_unfair_lock_unlock(&g_rmu);
+    atomic_fetch_add(&g_cur_frame,GHOST_IDLE);
+    CHECK(tex_get(held)==base,"the actively read texture survives the trim");
+    unsigned before=g_ghost.n; own_ghost_trim();
+    CHECK(g_ghost.n==before-GHOST_TRIM && tex_get(held)==base,"only idle entries are trimmed with bounded work");
+    CHECK(own_ghost_has(held),"view presence check sees ghost without using it");
+    pthread_mutex_lock(&g_smu); ghost_use *u=nvn_hm_get(&g_ghost_use,&held); uint64_t stamp=u->frame;
+    pthread_mutex_unlock(&g_smu);
+    atomic_fetch_add(&g_cur_frame,1); own_ghost_has(held);
+    pthread_mutex_lock(&g_smu);CHECK(u->frame==stamp,"cached view does not refresh its texture's age");ghost_del_locked(held);pthread_mutex_unlock(&g_smu);
+    vc_ghost_commit(); os_unfair_lock_lock(&g_rmu);
+    CHECK(nvn_hm_get(&g_vc,&held)==NULL,"view is retired after ghost eviction");os_unfair_lock_unlock(&g_rmu);
+    CHECK(g_deferred.count>0,"retired resources wait behind a submission fence");
+}
+static int wait_sem(dispatch_semaphore_t s) { return !dispatch_semaphore_wait(s,dispatch_time(DISPATCH_TIME_NOW,3*NSEC_PER_SEC)); }
+static void serialization(void) {
+    dispatch_semaphore_t compiling=dispatch_semaphore_create(0), finish=dispatch_semaphore_create(0), writing=dispatch_semaphore_create(0), finish_write=dispatch_semaphore_create(0), done=dispatch_semaphore_create(0), second=dispatch_semaphore_create(0);
+    dispatch_queue_t q=dispatch_get_global_queue(QOS_CLASS_USER_INITIATED,0);
+    dispatch_async(q,^{ser_compile_begin();dispatch_semaphore_signal(compiling);dispatch_semaphore_wait(finish,DISPATCH_TIME_FOREVER);ser_compile_end();});
+    CHECK(wait_sem(compiling),"compiler entered");
+    dispatch_async(q,^{ser_begin();dispatch_semaphore_signal(writing);dispatch_semaphore_wait(finish_write,DISPATCH_TIME_FOREVER);ser_end();dispatch_semaphore_signal(done);});
+    int wanted=0;for(int i=0;i<1000&&!wanted;i++){pthread_mutex_lock(&g_ser_mu);wanted=g_ser_want;pthread_mutex_unlock(&g_ser_mu);if(!wanted)usleep(1000);}
+    CHECK(wanted,"serialization waits for the active compile");
+    CHECK(dispatch_semaphore_wait(writing,DISPATCH_TIME_NOW)!=0,"write cannot overlap the active compile");
+    dispatch_semaphore_signal(finish);CHECK(wait_sem(writing),"write starts after compile ends");
+    dispatch_async(q,^{ser_compile_begin();dispatch_semaphore_signal(second);ser_compile_end();});
+    CHECK(dispatch_semaphore_wait(second,dispatch_time(DISPATCH_TIME_NOW,20*NSEC_PER_MSEC))!=0,"new compile waits during serialization");
+    dispatch_semaphore_signal(finish_write);CHECK(wait_sem(done)&&wait_sem(second),"writer and held compile both complete");
+}
+int main(void) { @autoreleasepool {ownership();serialization();CHECK(SUB_FLIGHT_MAX==512 && VIS_RING==SUB_FLIGHT_MAX && POST_RING==SUB_FLIGHT_MAX,"rings match the allocator's actual in-flight bound");printf("OOT2 refresh CPU: %d checks, %d failed\n",checks,failed);return failed!=0;} }
