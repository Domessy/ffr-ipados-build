# Keep private guest memory and recycling; tier 1 preserves the v7 Docked pixel budget.
# Documents/env.txt overrides these defaults; DM_GFX_SCALE=0 selects full tier.
DM_GUEST_FILE=1
DM_NVN_RT_RECYCLE=1
DM_GFX_SCALE=1
# Preserve the previous experimental profile's hold-off default; Documents overrides it.
DM_FPS_HOLD=off

# Experimental v12: upstream opt-in memory budgets; Documents/env.txt can A/B with 0.
DM_NVN_UPLOAD_IDLE_MS=2000
DM_NVN_UPLOAD_SRC_MB=96
