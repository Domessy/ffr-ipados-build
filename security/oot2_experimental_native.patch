diff --git a/dm/gfx/tests/oot2_experimental_cpu.m b/dm/gfx/tests/oot2_experimental_cpu.m
new file mode 100644
index 00000000..c9460647
--- /dev/null
+++ b/dm/gfx/tests/oot2_experimental_cpu.m
@@ -0,0 +1,76 @@
+// CPU ownership/cache and serializer-ordering regressions. No Metal device,
+// pipelines, command queues, game files or saves are opened.
+#include "../nvn/nvn_mtl.m"
+void *front_metal_layer(void) { return NULL; }
+module_t *module_of(const void *p) { (void)p; return NULL; }
+module_t *g_mod; int g_nmod;
+void svc_thread_dump(void) {}
+uint64_t now_ns(void) { return bp_now(); }
+static int checks, failed;
+#define CHECK(c, why) do { checks++; if (!(c)) { failed++; fprintf(stderr,"FAIL: %s\n",why); } } while (0)
+@interface RefreshView : NSObject
+@property(nonatomic,strong) id parentTexture;
+@end
+@implementation RefreshView @end
+static void ownership(void) {
+    NSObject *base = [NSObject new];
+    for (uint64_t k=1;k<=900;k++) tex_put(k,base);
+    CHECK(g_ghost.n==900 && g_ghost_use.n==900,"more than 512 currently used textures survive");
+    for (uint64_t k=1;k<=900;k++) CHECK(tex_get(k)==base,"every finalized ID still resolves");
+    CHECK(g_ghost_lru->serial==1 && g_ghost_mru->serial==900,"reads update use order");
+    uint64_t held=17; RefreshView *view=[RefreshView new]; view.parentTexture=base;
+    vc_key key={.pf=MTLPixelFormatRGBA8Unorm,.nl=1,.ns=1};
+    os_unfair_lock_lock(&g_rmu);
+    vc_put(held,NULL,&key,(id)view); uint64_t made=g_vc_new;
+    CHECK(vc_get(held,&key,(id)base)==(id)view,"finalized texture's view is reused");
+    CHECK(vc_get(held,&key,(id)base)==(id)view && g_vc_new==made,"repeated reads make no view");
+    CHECK(vc_set_for(held,NULL,0)==NULL,"finalized 2D rows use their own memory owner");
+    os_unfair_lock_unlock(&g_rmu);
+    atomic_fetch_add(&g_cur_frame,GHOST_IDLE);
+    CHECK(tex_get(held)==base,"the actively read texture survives the trim");
+    unsigned before=g_ghost.n; own_ghost_trim();
+    CHECK(g_ghost.n==before-GHOST_TRIM && tex_get(held)==base,"only idle entries are trimmed with bounded work");
+    CHECK(own_ghost_has(held),"view presence check sees ghost without using it");
+    pthread_mutex_lock(&g_smu); ghost_use *u=nvn_hm_get(&g_ghost_use,&held); uint64_t stamp=u->frame;
+    pthread_mutex_unlock(&g_smu);
+    atomic_fetch_add(&g_cur_frame,1); own_ghost_has(held);
+    pthread_mutex_lock(&g_smu);CHECK(u->frame==stamp,"cached view does not refresh its texture's age");ghost_del_locked(held);pthread_mutex_unlock(&g_smu);
+    vc_ghost_commit(); os_unfair_lock_lock(&g_rmu);
+    CHECK(nvn_hm_get(&g_vc,&held)==NULL,"view is retired after ghost eviction");os_unfair_lock_unlock(&g_rmu);
+    CHECK(g_deferred.count>0,"retired resources wait behind a submission fence");
+}
+static int wait_sem(dispatch_semaphore_t s) { return !dispatch_semaphore_wait(s,dispatch_time(DISPATCH_TIME_NOW,3*NSEC_PER_SEC)); }
+static void serialization(void) {
+    dispatch_semaphore_t compiling=dispatch_semaphore_create(0), finish=dispatch_semaphore_create(0), writing=dispatch_semaphore_create(0), finish_write=dispatch_semaphore_create(0), done=dispatch_semaphore_create(0), second=dispatch_semaphore_create(0);
+    dispatch_queue_t q=dispatch_get_global_queue(QOS_CLASS_USER_INITIATED,0);
+    dispatch_async(q,^{ser_compile_begin();dispatch_semaphore_signal(compiling);dispatch_semaphore_wait(finish,DISPATCH_TIME_FOREVER);ser_compile_end();});
+    CHECK(wait_sem(compiling),"compiler entered");
+    dispatch_async(q,^{ser_begin();dispatch_semaphore_signal(writing);dispatch_semaphore_wait(finish_write,DISPATCH_TIME_FOREVER);ser_end();dispatch_semaphore_signal(done);});
+    int wanted=0;for(int i=0;i<1000&&!wanted;i++){pthread_mutex_lock(&g_ser_mu);wanted=g_ser_want;pthread_mutex_unlock(&g_ser_mu);if(!wanted)usleep(1000);}
+    CHECK(wanted,"serialization waits for the active compile");
+    CHECK(dispatch_semaphore_wait(writing,DISPATCH_TIME_NOW)!=0,"write cannot overlap the active compile");
+    dispatch_semaphore_signal(finish);CHECK(wait_sem(writing),"write starts after compile ends");
+    dispatch_async(q,^{ser_compile_begin();dispatch_semaphore_signal(second);ser_compile_end();});
+    CHECK(dispatch_semaphore_wait(second,dispatch_time(DISPATCH_TIME_NOW,20*NSEC_PER_MSEC))!=0,"new compile waits during serialization");
+    dispatch_semaphore_signal(finish_write);CHECK(wait_sem(done)&&wait_sem(second),"writer and held compile both complete");
+}
+static void storage_writes(void) {
+    // Exercise the actual commit/fence path: duplicate marks, report-only pages,
+    // completed fences, a new submission, and generation wrap must stay distinct.
+    pend_reset(); g_done=100;
+    sbw_note(0x100000,4096,SBW_GPU); sbw_note(0x100000,4096,SBW_GPU);
+    sbw_note(0x200000,16,SBW_REPORT);
+    CHECK(g_nsbw==2,"duplicate writes occupy one slot");
+    gw_commit(101);
+    CHECK(gw_live(0x100000,0x101000),"GPU write fence prevents unsafe shadow reuse");
+    CHECK(!gw_live(0x200000,0x201000),"report-only mark is not committed as a whole-page GPU write");
+    g_done=101; CHECK(!gw_live(0x100000,0x101000),"completed GPU fence releases the page");
+    pend_reset(); sbw_note(0x300000,4096,SBW_GPU); gw_commit(102);
+    CHECK(!gw_live(0x100000,0x101000),"new submission does not resurrect old write slots");
+    CHECK(gw_live(0x300000,0x301000),"new submission commits its own write");
+    g_done=102; g_pend_gen=UINT32_MAX; pend_reset();
+    sbw_note(0x100000,4096,SBW_GPU); gw_commit(103);
+    CHECK(g_pend_gen==1 && g_nsbw==1 && gw_live(0x100000,0x101000),"generation wrap clears stale slots and preserves new writes");
+    g_done=103;pend_reset();
+}
+int main(void) { @autoreleasepool {ownership();serialization();storage_writes();CHECK(SUB_FLIGHT_MAX==512 && VIS_RING==SUB_FLIGHT_MAX && POST_RING==SUB_FLIGHT_MAX,"rings match the allocator's actual in-flight bound");printf("OOT2 experimental CPU: %d checks, %d failed\n",checks,failed);return failed!=0;} }
diff --git a/dm/gfx/tests/t_zero_depth.m b/dm/gfx/tests/t_zero_depth.m
new file mode 100644
index 00000000..a0bf3255
--- /dev/null
+++ b/dm/gfx/tests/t_zero_depth.m
@@ -0,0 +1,68 @@
+// A new depth texture is zeroed in the upload batch (tex_zero_fill): large ones by copies from the zero buffer, not a clear pass (which fails with a GPU out-of-memory error on big attachments).
+// Every texel of every level and layer reads 0 afterwards, from a texture first filled with a non-zero depth.
+#include "../nvn/nvn_mtl.m"
+void *front_metal_layer(void) { return NULL; }
+module_t *module_of(const void *p) { (void)p; return NULL; }
+module_t *g_mod; int g_nmod;
+void svc_thread_dump(void) {}
+uint64_t now_ns(void) { return bp_now(); }
+static int checks, failed;
+#define CHECK(c, label) do { checks++; if (!(c)) { failed++; fprintf(stderr, "FAIL: %s\n", label); } } while (0)
+
+int main(void) { @autoreleasepool {
+    mtl_init();
+    NSError *error = nil;
+    id<MTLLibrary> library = [g_dev newLibraryWithSource:@"#include <metal_stdlib>\nusing namespace metal;\n"
+        "kernel void count_nz(depth2d<float,access::read> d [[texture(0)]], device atomic_uint *o [[buffer(0)]], uint2 p [[thread_position_in_grid]]) { if (p.x < d.get_width() && p.y < d.get_height() && d.read(p) != 0.0f) atomic_fetch_add_explicit(o, 1u, memory_order_relaxed); }\n" options:nil error:&error];
+    id<MTLComputePipelineState> counter = [g_dev newComputePipelineStateWithFunction:[library newFunctionWithName:@"count_nz"] error:&error];
+    CHECK(counter != nil, "synthetic non-zero counter compiles");
+    if (!counter) return 1;
+    id<MTLCommandQueue> queue = [g_dev newCommandQueue];
+    struct { int target, format; unsigned w, h, depth, levels; const char *label; } cases[] = {
+        {NVN_TEXTURE_TARGET_2D, NVN_FORMAT_DEPTH16, 4096, 4096, 1, 1, "Depth16 4096x4096 (copies)"},
+        {NVN_TEXTURE_TARGET_2D, NVN_FORMAT_DEPTH32F, 2048, 2048, 1, 1, "Depth32F 2048x2048, the smallest size that is copied"},
+        {NVN_TEXTURE_TARGET_2D_ARRAY, NVN_FORMAT_DEPTH16, 3072, 3072, 2, 3, "Depth16 3072x3072 two layers, three levels (copies)"},
+        {NVN_TEXTURE_TARGET_2D, NVN_FORMAT_DEPTH32F, 16384, 257, 1, 1, "Depth32F 16384x257: the rows go in pieces and the last piece is one row"},
+        {NVN_TEXTURE_TARGET_2D, NVN_FORMAT_DEPTH16, 1024, 1024, 1, 1, "Depth16 1024x1024 (clear pass)"},
+    };
+    for (unsigned i = 0; i < sizeof cases / sizeof *cases; i++) {
+        tex_t t = {.magic = MAGIC('T', 'E', 'X', 0), .serial = 99601 + i};
+        t.d = (nvn_texdesc){.target = cases[i].target, .format = cases[i].format, .width = cases[i].w, .height = cases[i].h, .depth = cases[i].depth, .levels = cases[i].levels, .samples = 1};
+        MTLTextureDescriptor *descriptor = tex_desc(&t, 0);
+        id<MTLTexture> base = descriptor ? [g_dev newTextureWithDescriptor:descriptor] : nil;
+        CHECK(base != nil, "synthetic depth texture allocates");
+        if (!base) continue;
+        size_t bpp = base.pixelFormat == MTLPixelFormatDepth16Unorm ? 2 : 4, poison_bytes = (size_t)cases[i].w * cases[i].h * bpp;
+        id<MTLBuffer> poison = [g_dev newBufferWithLength:poison_bytes options:MTLResourceStorageModeShared];
+        if (bpp == 2) for (size_t k = 0; k < poison_bytes / 2; k++) ((uint16_t *)poison.contents)[k] = 0xbfff;   // 0.75
+        else for (size_t k = 0; k < poison_bytes / 4; k++) ((float *)poison.contents)[k] = .75f;
+        id<MTLCommandBuffer> cb = [queue commandBuffer]; id<MTLBlitCommandEncoder> blit = [cb blitCommandEncoder];
+        for (NSUInteger l = 0; l < base.mipmapLevelCount; l++) for (NSUInteger s = 0; s < base.arrayLength; s++) {
+            NSUInteger w = MAX(base.width >> l, 1u), h = MAX(base.height >> l, 1u);
+            [blit copyFromBuffer:poison sourceOffset:0 sourceBytesPerRow:w * bpp sourceBytesPerImage:w * h * bpp sourceSize:MTLSizeMake(w, h, 1) toTexture:base destinationSlice:s destinationLevel:l destinationOrigin:MTLOriginMake(0, 0, 0)];
+        }
+        [blit endEncoding]; [cb commit]; [cb waitUntilCompleted];
+        CHECK(cb.status == MTLCommandBufferStatusCompleted, "the texture takes its non-zero depth");
+        res_add(base);
+        state_reset(); memset(&R, 0, sizeof R); mtl_sub_begin();
+        tex_zero_fill(base);
+        mtl_sub_commit(); mtl_drain();
+        CHECK(!mtl_last_commit_error(), "zero fill completes without GPU error");
+        id<MTLBuffer> count = [g_dev newBufferWithLength:4 options:MTLResourceStorageModeShared];
+        int clean = 1;
+        for (NSUInteger l = 0; l < base.mipmapLevelCount; l++) for (NSUInteger s = 0; s < base.arrayLength; s++) {
+            id<MTLTexture> v = [base newTextureViewWithPixelFormat:base.pixelFormat textureType:MTLTextureType2D levels:NSMakeRange(l, 1) slices:NSMakeRange(s, 1)];
+            *(uint32_t *)count.contents = 0;
+            cb = [queue commandBuffer]; id<MTLComputeCommandEncoder> e = [cb computeCommandEncoder];
+            [e setComputePipelineState:counter]; [e setTexture:v atIndex:0]; [e setBuffer:count offset:0 atIndex:0];
+            [e dispatchThreads:MTLSizeMake(v.width, v.height, 1) threadsPerThreadgroup:MTLSizeMake(16, 16, 1)]; [e endEncoding]; [cb commit]; [cb waitUntilCompleted];
+            CHECK(cb.status == MTLCommandBufferStatusCompleted, "the texels are read on the GPU");
+            if (*(uint32_t *)count.contents) { clean = 0; fprintf(stderr, "  level %lu layer %lu: %u texels not zero\n", (unsigned long)l, (unsigned long)s, *(uint32_t *)count.contents); }
+        }
+        CHECK(clean, cases[i].label);
+        printf("case %u: %s %s\n", i, cases[i].label, clean ? "PASS" : "FAIL");
+        defer_obj_release(base);
+    }
+    printf("depth zero fill: %d checks, %d failed\n", checks, failed);
+    return failed != 0;
+} }
