diff --git a/dm/gfx/tests/t_dead_targets.m b/dm/gfx/tests/t_dead_targets.m
new file mode 100644
index 00000000..f209b38e
--- /dev/null
+++ b/dm/gfx/tests/t_dead_targets.m
@@ -0,0 +1,87 @@
+// Render targets another one drew over (nvn_mtl.m's tu_pass, nvn_owner.m's own_alias_dead_locked): a shared render target goes once another target of its pool wrote its bytes after
+// its last use and it has stayed unused for TU_IDLE. One read every frame stays, as does one nothing overlaps, one whose overlapping neighbour wrote before its last use, and one a pin
+// holds. A released target's serial no longer resolves, its texture ID drops its view (a pool walk reads it as the dummy until a pass writes it), and its next use makes it again.
+// Last, a pass over 4,000 covered targets (it prints the time).
+#include "../nvn/nvn_mtl.m"
+void *front_metal_layer(void) { return NULL; }
+module_t *module_of(const void *p) { (void)p; return NULL; }
+module_t *g_mod; int g_nmod;
+void svc_thread_dump(void) {}
+uint64_t now_ns(void) { return bp_now(); }
+static int checks, failed;
+#define CHECK(c, label) do { checks++; if (!(c)) { failed++; fprintf(stderr, "FAIL: %s (line %d)\n", label, __LINE__); } } while (0)
+
+static tex_t target(pool_t *pool, uint64_t serial, int64_t off, NVNformat format, unsigned w) {
+    tex_t t = {.magic = MAGIC('T','E','X',0), .serial = serial, .pool = pool, .mem = pool->mem + off, .off = off};
+    t.d = (nvn_texdesc){.target = NVN_TEXTURE_TARGET_2D, .format = format, .flags = NVN_TEXTURE_FLAGS_COMPRESSIBLE, .width = w, .height = w, .depth = 1, .levels = 1, .samples = 1};
+    nvn_tex_layout(&t.d, &t.L); mtl_tex_init(&t); return t;
+}
+static int shared(id o) { pthread_mutex_lock(&g_smu); int r = (g_alias_set && CFSetContainsValue(g_alias_set, (__bridge const void *)o)); pthread_mutex_unlock(&g_smu); return r; }
+static int covered(id o) { own_use u; return tu_use_of(o, &u); }
+static void at(uint32_t now) { g_tu_now = now; }
+static void submissions(void) { for (int k = 0; k <= ALIAS_IDLE; k++) { CHECK(mtl_wait(mtl_sub_commit(), 5000000000ull), "submission completes"); mtl_sub_begin(); } }   // past ALIAS_IDLE: no lookup found them lately
+static void pass(uint32_t now) { submissions(); at(now); g_tu_last = now - 10; tu_pass(); }
+static void drawn(id<MTLTexture> t) { tu_wrote(t); }
+
+int main(void) { @autoreleasepool {
+    mtl_init(); mtl_sub_begin(); g_tu_manual = 1;
+    void *mem = NULL; posix_memalign(&mem, 16384, 64 << 20); memset(mem, 0, 64 << 20);
+    pool_t pool = {.magic = MAGIC('P','O','O','L'), .flags = NVN_MEMORY_POOL_FLAGS_CPU_NO_ACCESS | NVN_MEMORY_POOL_FLAGS_GPU_CACHED | NVN_MEMORY_POOL_FLAGS_COMPRESSIBLE, .mem = mem, .size = 64 << 20};
+    at(100);
+    tex_t a = target(&pool, 97001, 0, NVN_FORMAT_RGBA8, 64), b = target(&pool, 97002, 0, NVN_FORMAT_R32F, 64);           // b over a's bytes
+    tex_t c = target(&pool, 97003, 1 << 20, NVN_FORMAT_RGBA8, 64);                                                         // nothing over it
+    tex_t d = target(&pool, 97004, 2 << 20, NVN_FORMAT_RGBA8, 64), e = target(&pool, 97005, 2 << 20, NVN_FORMAT_R32F, 64); // e over d, d read every frame
+    tex_t f = target(&pool, 97006, 3 << 20, NVN_FORMAT_RGBA8, 64), g = target(&pool, 97007, 3 << 20, NVN_FORMAT_R32F, 64); // g over f, f pinned
+    tex_t h = target(&pool, 97008, 4 << 20, NVN_FORMAT_RGBA8, 64), i = target(&pool, 97009, 4 << 20, NVN_FORMAT_R32F, 64); // i wrote before h was made, h drew over i
+    id<MTLTexture> ta = tex_mtl(&a), tc = tex_mtl(&c), td = tex_mtl(&d), tf = tex_mtl(&f), ti = tex_mtl(&i);
+    CHECK(ta && (ta.usage & MTLTextureUsageRenderTarget) && covered(ta), "a compressible render target of a GPU-only pool is covered");
+    drawn(ta); drawn(tc); drawn(td); drawn(tf); drawn(ti);
+    at(110);
+    id<MTLTexture> tb = tex_mtl(&b), te = tex_mtl(&e), tg = tex_mtl(&g), th = tex_mtl(&h);
+    CHECK(tb && tb != ta && shared(ta) && shared(tb), "another description over the bytes leaves the target a live object resolves to (the takeover)");
+    drawn(tb); drawn(te); drawn(tg); drawn(th);
+    mtl_tex_pin(f.serial);
+    for (uint32_t now = 120; now <= 160; now += 10) { at(now); CHECK(tex_mtl(&d) == td, "the target read every frame resolves to its texture"); }
+    {   // c's texture ID, bound (a use) and then not
+        mtl_reg_tex(5, &a, NULL); mtl_reg_tex(6, &c, NULL);
+        os_unfair_lock_lock(&g_rmu); void *va = NULL, *vc = NULL; at(100); tex_fast_rid(5, &va); at(160); tex_fast_rid(6, &vc); os_unfair_lock_unlock(&g_rmu);
+        CHECK(va && vc, "the IDs have views");
+    }
+    pass(160);
+    CHECK(!shared(ta) && !tex_get(a.serial), "a target drawn over and unused for TU_IDLE goes, with its serial entry");
+    CHECK(pool_unwritten_target(&a), "a pool walk reads it as the dummy until a pass writes it");
+    os_unfair_lock_lock(&g_rmu); CHECK(!g_treg[5].view, "its texture ID dropped its view"); CHECK(g_treg[6].view != NULL, "an ID of a target that stays keeps its view"); os_unfair_lock_unlock(&g_rmu);
+    CHECK(shared(tb) && tex_get(b.serial) == tb, "the target that drew over it stays (written after nothing over it)");
+    CHECK(shared(tc), "a target nothing overlaps stays");
+    CHECK(shared(td), "a target read every frame stays");
+    CHECK(shared(tf) && tex_get(f.serial) == tf, "a pinned target stays");
+    CHECK(shared(th), "a target whose neighbour wrote before its last use stays");
+    CHECK(!shared(ti), "and the neighbour it drew over goes");
+    CHECK(g_tu_n == 2 && g_tu_pinned == 1, "two released, one kept by a pin");
+    mtl_tex_unpin(f.serial);
+    at(170);
+    id<MTLTexture> ta2 = tex_mtl(&a); drawn(ta2);
+    CHECK(ta2 && ta2 != ta && shared(ta2) && tex_get(a.serial) == ta2 && covered(ta2), "drawn into again, it is made again and covered");
+    CHECK(g_tu_remade == 1, "and counted as made again");
+    pass(175);
+    CHECK(!shared(tb) && shared(ta2), "b goes in turn: a2 drew over its bytes after its last use");
+    CHECK(!shared(tf) && shared(tg), "unpinned, the target drawn over goes");
+    CHECK(!tex_get(f.serial), "released unpinned target no longer resolves");
+    {   // The cost: 4,000 covered targets in 2,000 overlapping pairs, half of them released
+        enum { N = 2000 }; static tex_t ts[2 * N];
+        at(300);
+        for (int k = 0; k < N; k++) { ts[2 * k] = target(&pool, 98000 + 2 * k, (8 << 20) + ((int64_t)k << 14), NVN_FORMAT_RGBA8, 32); drawn(tex_mtl(&ts[2 * k])); }
+        at(310);
+        for (int k = 0; k < N; k++) { ts[2 * k + 1] = target(&pool, 98001 + 2 * k, (8 << 20) + ((int64_t)k << 14), NVN_FORMAT_R32F, 32); drawn(tex_mtl(&ts[2 * k + 1])); }
+        uint64_t n0 = g_tu_n, ns0 = g_tu_ns;
+        int64_t rounds = 0; for (uint32_t now = 350; g_tu_n - n0 < N && rounds < 20; now += 10, rounds++) pass(now);
+        double ms = (g_tu_ns - ns0) / 1e6 / (double)rounds;
+        printf("a pass over %u covered targets: %.3f ms (%lld passes released %llu)\n", g_tu.n + (unsigned)(g_tu_n - n0), ms, (long long)rounds, (unsigned long long)(g_tu_n - n0));
+        CHECK(g_tu_n - n0 == N, "every target drawn over goes, TU_MAX a pass");
+        CHECK(ms < 20, "a pass stays short");
+        for (int k = 0; k < 2 * N; k++) mtl_tex_release(&ts[k]);
+    }
+    mtl_tex_release(&a); mtl_tex_release(&b); mtl_tex_release(&c); mtl_tex_release(&d); mtl_tex_release(&e); mtl_tex_release(&f); mtl_tex_release(&g); mtl_tex_release(&h); mtl_tex_release(&i);
+    mtl_sub_commit(); mtl_drain(); CHECK(!mtl_last_commit_error(), "no GPU error");
+    printf("t_dead_targets: %d checks, %d failed\n", checks, failed); return failed != 0;
+} }
diff --git a/dm/gfx/tests/t_res_cb.m b/dm/gfx/tests/t_res_cb.m
new file mode 100644
index 00000000..6222a86d
--- /dev/null
+++ b/dm/gfx/tests/t_res_cb.m
@@ -0,0 +1,153 @@
+// DM_RES_CB=1: g_res is attached to neither queue, and every command buffer committed on g_q or g_q4 names it (useResidencySet) after its last begin; unset, both queues hold it and
+// no command buffer names it. Real Metal: the queues' addResidencySet and commits and the command buffers' begin, useResidencySet and commit are wrapped, so the calls each command
+// buffer gets are counted whichever path made it (calls, not what the driver keeps resident). Checks, each run with the switch unset and set and the encode thread off and on
+// (DM_NVN_ENC_THREAD): the queues' sets; a submission with a cut and an upload batch (three command buffers); a present snapshot and its present through the display link; an offscreen
+// present (present_offscreen_m4); a classic command buffer (q_cb, by mtl_drain); one each.
+// A wait on an indirect draw's count (mdi_wait) and the warm-up pass (warm_start) are not driven here
+#include "../nvn/nvn_mtl.m"
+#import <objc/runtime.h>
+@interface FakeLinkUpdate : NSObject
+@property id<CAMetalDrawable> drawable;
+@property CFTimeInterval targetPresentationTimestamp;
+@end
+@implementation FakeLinkUpdate
+@end
+static CAMetalLayer *g_test_layer;
+void *front_metal_layer(void) { return (__bridge void *)g_test_layer; }
+module_t *module_of(const void *p) { (void)p; return NULL; }
+module_t *g_mod; int g_nmod;
+void svc_thread_dump(void) {}
+uint64_t now_ns(void) { return bp_now(); }
+static int checks, failed;
+#define CHECK(name, ok) do { int pass = !!(ok); checks++; failed += !pass; printf("%s: %s\n", name, pass ? "PASS" : "FAIL"); } while (0)
+
+// What the wrappers saw, under g_t_mu: command buffers that named g_res since their last begin (pointers; a commit takes its buffer out); since mark(), commits on each queue
+// ([0] g_q, [1] g_q4), those whose buffer had not named it and namings of g_res; and the queues g_res was attached to
+static pthread_mutex_t g_t_mu = PTHREAD_MUTEX_INITIALIZER;
+static CFMutableSetRef g_t_named;
+static uint64_t g_t_commits[2], g_t_unnamed[2], g_t_namings; static int g_t_attached[2];
+static void t_committed(int q4, void *cb) {
+    pthread_mutex_lock(&g_t_mu); g_t_commits[q4]++; if (!CFSetContainsValue(g_t_named, cb)) g_t_unnamed[q4]++; CFSetRemoveValue(g_t_named, cb); pthread_mutex_unlock(&g_t_mu);
+}
+static IMP o_use_cl, o_use_4, o_begin_4, o_commit_cl, o_commit_4, o_commit_4o, o_add_cl, o_add_4;
+static void h_use(id self, SEL s, id set, IMP o) {
+    if (set == g_res) { pthread_mutex_lock(&g_t_mu); CFSetAddValue(g_t_named, (__bridge void *)self); g_t_namings++; pthread_mutex_unlock(&g_t_mu); }
+    ((void (*)(id, SEL, id))o)(self, s, set);
+}
+static void h_use_cl(id self, SEL s, id set) { h_use(self, s, set, o_use_cl); }
+static void h_use_4(id self, SEL s, id set) { h_use(self, s, set, o_use_4); }
+static void h_begin_4(id self, SEL s, id al) {   // a begin drops the buffer's sets
+    pthread_mutex_lock(&g_t_mu); CFSetRemoveValue(g_t_named, (__bridge void *)self); pthread_mutex_unlock(&g_t_mu);
+    ((void (*)(id, SEL, id))o_begin_4)(self, s, al);
+}
+static void h_commit_cl(id self, SEL s) {
+    if ([(id<MTLCommandBuffer>)self commandQueue] == g_q) t_committed(0, (__bridge void *)self);
+    ((void (*)(id, SEL))o_commit_cl)(self, s);
+}
+static void h_commit_4(id self, SEL s, __unsafe_unretained id const *b, NSUInteger n) {
+    if (self == g_q4) for (NSUInteger i = 0; i < n; i++) t_committed(1, (__bridge void *)b[i]);
+    ((void (*)(id, SEL, __unsafe_unretained id const *, NSUInteger))o_commit_4)(self, s, b, n);
+}
+static void h_commit_4o(id self, SEL s, __unsafe_unretained id const *b, NSUInteger n, id o) {
+    if (self == g_q4) for (NSUInteger i = 0; i < n; i++) t_committed(1, (__bridge void *)b[i]);
+    ((void (*)(id, SEL, __unsafe_unretained id const *, NSUInteger, id))o_commit_4o)(self, s, b, n, o);
+}
+static void h_add(id self, SEL s, id set, IMP o) {
+    if (set == g_res) { pthread_mutex_lock(&g_t_mu); if (self == g_q) g_t_attached[0]++; if (self == g_q4) g_t_attached[1]++; pthread_mutex_unlock(&g_t_mu); }
+    ((void (*)(id, SEL, id))o)(self, s, set);
+}
+static void h_add_cl(id self, SEL s, id set) { h_add(self, s, set, o_add_cl); }
+static void h_add_4(id self, SEL s, id set) { h_add(self, s, set, o_add_4); }
+static Method g_hooked[8]; static int g_nhooked;
+static void hook(Class c, SEL s, IMP h, IMP *o) {   // a method two classes share (a common superclass) is wrapped once
+    Method m = class_getInstanceMethod(c, s);
+    if (!m) { checks++; failed++; printf("%s has %s: FAIL\n", class_getName(c), sel_getName(s)); return; }
+    for (int i = 0; i < g_nhooked; i++) if (g_hooked[i] == m) return;
+    g_hooked[g_nhooked++] = m; *o = method_setImplementation(m, h);
+}
+static void hooks(void) { @autoreleasepool {
+    id<MTLDevice> d = MTLCreateSystemDefaultDevice(); id<MTLCommandQueue> q = [d newCommandQueue]; id<MTL4CommandQueue> q4 = [d newMTL4CommandQueue];
+    Class ccl = [[q commandBuffer] class], c4 = [[d newCommandBuffer] class];
+    hook(ccl, @selector(useResidencySet:), (IMP)h_use_cl, &o_use_cl);
+    hook(c4, @selector(useResidencySet:), (IMP)h_use_4, &o_use_4);
+    hook(c4, @selector(beginCommandBufferWithAllocator:), (IMP)h_begin_4, &o_begin_4);
+    hook(ccl, @selector(commit), (IMP)h_commit_cl, &o_commit_cl);
+    hook([q4 class], @selector(commit:count:), (IMP)h_commit_4, &o_commit_4);
+    hook([q4 class], @selector(commit:count:options:), (IMP)h_commit_4o, &o_commit_4o);
+    hook([q class], @selector(addResidencySet:), (IMP)h_add_cl, &o_add_cl);
+    hook([q4 class], @selector(addResidencySet:), (IMP)h_add_4, &o_add_4);
+} }
+
+static int g_on;   // DM_RES_CB=1
+static void mark(void) { pthread_mutex_lock(&g_t_mu); memset(g_t_commits, 0, sizeof g_t_commits); memset(g_t_unnamed, 0, sizeof g_t_unnamed); g_t_namings = 0; pthread_mutex_unlock(&g_t_mu); }
+static void expect(const char *what, int q4, uint64_t want) {   // the command buffers committed on the queue since mark(): as many as the path commits, and each named the set (switch set) or none did (unset)
+    pthread_mutex_lock(&g_t_mu); uint64_t c = g_t_commits[q4], u = g_t_unnamed[q4], n = g_t_namings; pthread_mutex_unlock(&g_t_mu);
+    char name[200]; printf("%s: %llu command buffers committed on %s, %llu without the set named\n", what, (unsigned long long)c, q4 ? "g_q4" : "g_q", (unsigned long long)u);
+    snprintf(name, sizeof name, "%s: commits %llu command buffer%s on %s", what, (unsigned long long)want, want == 1 ? "" : "s", q4 ? "g_q4" : "g_q"); CHECK(name, c == want);
+    if (g_on) { snprintf(name, sizeof name, "%s: each one names the residency set", what); CHECK(name, u == 0); }
+    else { snprintf(name, sizeof name, "%s: none names it (the queues hold it)", what); CHECK(name, u == c && n == 0); }
+}
+static CAMetalLayer *offscreen_layer(void) {
+    CAMetalLayer *l = [CAMetalLayer layer]; l.device = g_dev; l.pixelFormat = MTLPixelFormatBGRA8Unorm; l.framebufferOnly = NO; l.drawableSize = CGSizeMake(8, 8); return l;
+}
+
+int main(void) { @autoreleasepool {
+    alarm(30); setbuf(stdout, NULL);
+    setenv("DM_PRESENT_HZ", "0", 1); setenv("DM_PRESENT_SNAP", "2", 1); setenv("DM_NVN_CUT_BUSY", "0", 1);   // a snapshot ring; every cut commits, whatever the GPU is still running
+    g_t_named = CFSetCreateMutable(NULL, 0, NULL);
+    hooks();
+    mtl_init();
+    { const char *e = getenv("DM_RES_CB"); g_on = e && atoi(e) == 1; }
+    printf("DM_RES_CB %s, encode thread %s\n", g_on ? "set" : "unset", rec_on() ? "on" : "off");
+    CHECK("the switch read as the test reads it", g_res_cb == g_on);
+    { const char *e = getenv("DM_NVN_ENC_THREAD"); CHECK("the encode thread as DM_NVN_ENC_THREAD asks", e && rec_on() == (atoi(e) > 0)); }
+    CHECK(g_on ? "the residency set is attached to neither queue" : "the residency set is attached to both queues",
+          g_on ? !g_t_attached[0] && !g_t_attached[1] : g_t_attached[0] == 1 && g_t_attached[1] == 1);
+
+    // A submission: a segment cut off at a pass boundary, an upload batch, then its last command buffer
+    state_reset(); memset(&R, 0, sizeof R); mark();
+    mtl_sub_begin();
+    uint64_t cuts = g_cuts; g_stat_draw += (uint64_t)cut_draws(); sub_cut();
+    CHECK("the cut committed a segment", g_cuts == cuts + 1);
+    up_begin(); up_flush();
+    CHECK("the submission completed", mtl_wait(mtl_sub_commit(), 5000000000ull));
+    expect("a submission with a cut and an upload batch", 1, 3);
+
+    // A present through the display link, with present snapshots: the snapshot's copy, then the present of the snapshot to a drawable
+    g_test_layer = offscreen_layer(); mtl_present_layer(8, 8);
+    g_dm_present_link = 1; g_link_started = 1; g_link_owns_layer = 1;   // display-link mode without a link thread (t_present_alloc)
+    NvMetalDisplayLinkDelegate *link = [NvMetalDisplayLinkDelegate new];
+    MTLTextureDescriptor *d = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatRGBA8Unorm width:8 height:8 mipmapped:NO];
+    d.storageMode = MTLStorageModeShared; d.usage = MTLTextureUsageShaderRead;
+    id<MTLTexture> am = [g_dev newTextureWithDescriptor:d];   // the game's texture: what it holds is not looked at
+    tex_t a = {.magic=MAGIC('T','E','X',0), .serial=93001};
+    a.d.width = a.d.height = 8; a.d.depth = a.d.levels = a.d.samples = 1;
+    a.d.target = NVN_TEXTURE_TARGET_2D; a.d.format = NVN_FORMAT_RGBA8;
+    serial_put(a.serial, am); res_add(am); res_commit(); mark();
+    uint64_t copies = g_snap_v; present_enqueue(&a, 1. / 60, NULL, 0, NULL); snap_commit_wait(g_snap_v);
+    CHECK("the present was copied into a snapshot", g_snap_v == copies + 1 && [g_snap_ev waitUntilSignaledValue:g_snap_v timeoutMS:2000]);
+    expect("a present snapshot", 1, 1);
+    CAMetalLayer *l = offscreen_layer(); [g_q4 addResidencySet:l.residencySet];
+    FakeLinkUpdate *u = [FakeLinkUpdate new]; u.drawable = [l nextDrawable]; u.targetPresentationTimestamp = CACurrentMediaTime() + 0.016;
+    uint64_t done = g_pq_done; mark();
+    [link metalDisplayLink:(CAMetalDisplayLink *)(id)u needsUpdate:(CAMetalDisplayLinkUpdate *)u];
+    pthread_mutex_lock(&g_pq_mu); struct timespec ts; clock_gettime(CLOCK_REALTIME, &ts); ts.tv_sec += 5;
+    while (g_pq_inflight && pthread_cond_timedwait(&g_pq_cv, &g_pq_mu, &ts) != ETIMEDOUT) {}
+    int presented = !g_pq_inflight && g_pq_done > done; pthread_mutex_unlock(&g_pq_mu);
+    CHECK("the present completed", presented);
+    expect("a present through the display link", 1, 1);
+
+    // An offscreen present (a whole-window screenshot's pass)
+    d.pixelFormat = MTLPixelFormatBGRA8Unorm; d.storageMode = MTLStorageModePrivate; d.usage = MTLTextureUsageRenderTarget | MTLTextureUsageShaderRead;
+    id<MTLTexture> out = [g_dev newTextureWithDescriptor:d]; res_add(out); res_commit();
+    static const int whole[4] = {0, 0, 8, 8}; mark();
+    CHECK("the offscreen present completed", present_offscreen_wait(am, whole, out) != PRESENT_FAILED);
+    expect("an offscreen present", 1, 1);
+
+    // A classic command buffer (q_cb): mtl_drain commits one and waits for it
+    mark(); mtl_drain();
+    expect("a classic command buffer", 0, 1);
+
+    printf("t_res_cb (DM_RES_CB %s, encode thread %s): %d checks, %d failed\n", g_on ? "set" : "unset", rec_on() ? "on" : "off", checks, failed);
+    return failed != 0;
+} }
diff --git a/dm/gfx/tests/t_mfx_passes.h b/dm/gfx/tests/t_mfx_passes.h
new file mode 100644
index 00000000..8d797646
--- /dev/null
+++ b/dm/gfx/tests/t_mfx_passes.h
@@ -0,0 +1,55 @@
+// Draw passes in the replay's command buffer around a MetalFX scaler, through the host's own draw-pass encoder (enc_r_begin_pass / enc_r_end_pass, as a game's draws are
+// encoded): a slow pass that writes the scaler's input just before it, and a pass that copies the scaler's output just after it (t_dlss_mfx, t_upscaler_mfx; mfx_order in
+// nvn_mtl.m). Include after nvn_mtl.m.
+static id<MTLRenderPipelineState> pass_pso(NSString *fs, MTLPixelFormat pf) {
+    NSError *err = nil;
+    NSString *src = [@"#include <metal_stdlib>\nusing namespace metal;\nstruct A { float4 c; uint iters; };\n"
+                     "vertex float4 vs(uint v [[vertex_id]]) { return float4(v == 1 ? 3.0f : -1.0f, v == 2 ? 3.0f : -1.0f, 0, 1); }\n" stringByAppendingString:fs];
+    id<MTLLibrary> lib = [g_dev newLibraryWithSource:src options:nil error:&err];
+    id<MTL4Compiler> comp = [g_dev newCompilerWithDescriptor:[MTL4CompilerDescriptor new] error:&err];
+    MTL4LibraryFunctionDescriptor *vf = [MTL4LibraryFunctionDescriptor new], *ff = [MTL4LibraryFunctionDescriptor new]; vf.name = @"vs"; ff.name = @"fs"; vf.library = ff.library = lib;
+    MTL4RenderPipelineDescriptor *pd = [MTL4RenderPipelineDescriptor new]; pd.vertexFunctionDescriptor = vf; pd.fragmentFunctionDescriptor = ff; pd.colorAttachments[0].pixelFormat = pf;
+    id<MTLRenderPipelineState> ps = lib && comp ? [comp newRenderPipelineStateWithDescriptor:pd compilerTaskOptions:nil error:&err] : nil;
+    if (!ps) fprintf(stderr, "pass pipeline: %s\n", err.description.UTF8String);
+    return ps;
+}
+static id<MTL4ArgumentTable> pass_table(id<MTLBuffer> b, id<MTLTexture> t) {
+    MTL4ArgumentTableDescriptor *ad = [MTL4ArgumentTableDescriptor new]; ad.maxBufferBindCount = 1; ad.maxTextureBindCount = 1;
+    NSError *err = nil; id<MTL4ArgumentTable> at = [g_dev newArgumentTableWithDescriptor:ad error:&err];
+    static NSMutableArray *bufs; if (!bufs) bufs = [NSMutableArray new];   // until the test ends (the table holds only the address)
+    if (b) { [bufs addObject:b]; [at setAddress:b.gpuAddress atIndex:0]; res_add(b); res_commit(); }
+    if (t) [at setTexture:t.gpuResourceID atIndex:0];
+    return at;
+}
+// One full-screen triangle into dst with ps and the fragment argument table at. bare: the pass ends with no barrier, as a MetalFX scaler's own encoders end; else enc_r_end_pass
+// ends it (the relaxed end with DM_NVN_BARRIER=game, the full one otherwise)
+static int pass_draw(id<MTLRenderPipelineState> ps, id<MTL4ArgumentTable> at, id<MTLTexture> dst, int bare) {
+    static NSMutableArray *keep;   // until the test ends: the encoding thread may encode the draw after this returns
+    if (!ps || !at || !(dst.usage & MTLTextureUsageRenderTarget)) return 0;
+    if (!keep) keep = [NSMutableArray new];
+    [keep addObject:at];
+    rp_end(); if (g_blit) { enc_b_end(g_blit); g_blit = nil; }
+    MTL4RenderPassDescriptor *rp = [MTL4RenderPassDescriptor new];
+    rp.colorAttachments[0].texture = dst; rp.colorAttachments[0].loadAction = MTLLoadActionDontCare; rp.colorAttachments[0].storeAction = MTLStoreActionStore;
+    id<MTL4RenderCommandEncoder> e = enc_r_begin_pass(rp);
+    [e setRenderPipelineState:ps]; [e setArgumentTable:at atStages:MTLRenderStageFragment];
+    [e drawPrimitives:MTLPrimitiveTypeTriangle vertexStart:0 vertexCount:3];
+    if (bare) { gp_end(e); [e endEncoding]; } else enc_r_end_pass(e);
+    args_dirty_all();
+    return 1;
+}
+// A slow pass (iters steps a fragment) that fills t with colour c
+static int slow_draw(id<MTLTexture> t, const float c[4], uint32_t iters, int bare) {
+    static id<MTLRenderPipelineState> ps; static MTLPixelFormat pf;
+    if (!ps || pf != t.pixelFormat) { pf = t.pixelFormat;
+        ps = pass_pso(@"fragment float4 fs(constant A &a [[buffer(0)]], float4 p [[position]]) { float x = p.x; for (uint k = 0; k < a.iters; k++) x = fma(x, 1.0000001f, 0.5f);"
+                       " return x > -1.0f ? a.c : float4(0); }\n", pf); }
+    struct { float c[4]; uint32_t iters, pad[3]; } a = {{c[0], c[1], c[2], c[3]}, iters, {0}};
+    return pass_draw(ps, pass_table([g_dev newBufferWithBytes:&a length:sizeof a options:MTLResourceStorageModeShared], nil), t, bare);
+}
+// A pass that copies src into dst texel for texel (the same size)
+static int copy_draw(id<MTLTexture> src, id<MTLTexture> dst) {
+    static id<MTLRenderPipelineState> ps; static MTLPixelFormat pf;
+    if (!ps || pf != dst.pixelFormat) { pf = dst.pixelFormat; ps = pass_pso(@"fragment float4 fs(texture2d<float> t [[texture(0)]], float4 p [[position]]) { return t.read(uint2(p.xy)); }\n", pf); }
+    return pass_draw(ps, pass_table(nil, src), dst, 0);
+}
